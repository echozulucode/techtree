{
  "name": "@echozedlabs/techtree-themes",
  "version": "0.3.0",
  "description": "Built-in themes for the TechTree viewer (Civ-IV-inspired, minimal dark, host CSS variables).",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Eric Zimmerman (https://echozed.com)",
  "homepage": "https://echozed.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echozulucode/techtree.git",
    "directory": "packages/themes"
  },
  "bugs": {
    "url": "https://github.com/echozulucode/techtree/issues"
  },
  "keywords": [
    "tech-tree",
    "theme",
    "viewer"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./civ-iv": {
      "types": "./dist/civ-iv.d.ts",
      "import": "./dist/civ-iv.js"
    },
    "./minimal-dark": {
      "types": "./dist/minimal-dark.d.ts",
      "import": "./dist/minimal-dark.js"
    },
    "./css-variables": {
      "types": "./dist/css-variables.d.ts",
      "import": "./dist/css-variables.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@echozedlabs/techtree-schema": "workspace:*"
  }
}

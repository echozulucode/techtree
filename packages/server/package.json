{
  "name": "@echozedlabs/techtree-server",
  "version": "0.1.0",
  "description": "Thin governance server for TechTree: role-gated state mutations, append-only audit log, approval workflow.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Eric Zimmerman (https://echozed.com)",
  "homepage": "https://echozed.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echozulucode/techtree.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/echozulucode/techtree/issues"
  },
  "keywords": ["tech-tree", "server", "fastify", "audit", "approval"],
  "engines": {
    "node": ">=22.5.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "techtree-server": "./dist/cli.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@echozedlabs/techtree-ir": "workspace:*",
    "@echozedlabs/techtree-state": "workspace:*",
    "commander": "^12.1.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}

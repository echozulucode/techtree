{
  "name": "@echozedlabs/techtree-compiler",
  "version": "0.2.0",
  "description": "TechTree compiler and CLI: parse → validate → lint → layout → emit deterministic IR.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Eric Zimmerman (https://echozed.com)",
  "homepage": "https://echozed.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echozulucode/techtree.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/echozulucode/techtree/issues"
  },
  "keywords": [
    "tech-tree",
    "compiler",
    "cli",
    "graph",
    "dag"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "techtree": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@echozedlabs/techtree-ir": "workspace:*",
    "@echozedlabs/techtree-schema": "workspace:*",
    "@echozedlabs/techtree-state": "workspace:*",
    "chalk": "^5.4.0",
    "commander": "^12.1.0",
    "elkjs": "^0.9.3",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}

{
  "name": "@echozedlabs/techtree-ir",
  "version": "0.1.0",
  "description": "TechTree IR types — the domain-agnostic contract consumed by every downstream tool (compiler, viewer, server).",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Eric Zimmerman (https://echozed.com)",
  "homepage": "https://echozed.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echozulucode/techtree.git",
    "directory": "packages/ir"
  },
  "bugs": {
    "url": "https://github.com/echozulucode/techtree/issues"
  },
  "keywords": ["graph", "dag", "dependency", "tech-tree", "ir"],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm build"
  }
}
